OPENAI_API_KEY=tu_api_key_aqui

ELEVENLABS_API_KEY=tu_api_key_aqui

DATABASE_URL=postgresql://user:password@localhost:5432/tu_base_de_datos

ELEVENLABS_VOICE_ID=tu_voice_id_por_defecto

# Voces nativas por idioma (ElevenLabs Voice IDs)
# Si no se configuran, se usa ELEVENLABS_VOICE_ID como fallback.
# Buscar voces en: https://elevenlabs.io/voice-library
ELEVENLABS_VOICE_ES=tu_voice_id_aqui
ELEVENLABS_VOICE_LATAM=tu_voice_id_aqui
ELEVENLABS_VOICE_MX=tu_voice_id_aqui
ELEVENLABS_VOICE_EN=tu_voice_id_aqui
ELEVENLABS_VOICE_PT=tu_voice_id_aqui
ELEVENLABS_VOICE_DE=tu_voice_id_aqui
ELEVENLABS_VOICE_FR=tu_voice_id_aqui
ELEVENLABS_VOICE_IT=tu_voice_id_aqui

# AI Video Generation 
AI_VIDEO_PROVIDER=mock
KLING_API_KEY=tu_kling_api_key_aqui


# Meta Graph API & Webhooks
META_VERIFY_TOKEN=tu_token_secreto_unico
META_ACCESS_TOKEN=tu_system_user_token_unico

# IDs de las cuentas de Instagram (una por idioma/variante)
INSTAGRAM_ACCOUNT_ID_ES=tu_instagram_account_id
INSTAGRAM_ACCOUNT_ID_ES_LATAM=tu_instagram_account_id
INSTAGRAM_ACCOUNT_ID_ES_MX=tu_instagram_account_id
INSTAGRAM_ACCOUNT_ID_EN=tu_instagram_account_id
INSTAGRAM_ACCOUNT_ID_PT=tu_instagram_account_id
INSTAGRAM_ACCOUNT_ID_DE=tu_instagram_account_id
INSTAGRAM_ACCOUNT_ID_FR=tu_instagram_account_id
INSTAGRAM_ACCOUNT_ID_IT=tu_instagram_account_id
